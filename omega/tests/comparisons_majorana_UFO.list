#eeeeep 0.80  1E-11   100  1000   SM .false. scatter e- e- -> e- e- e+ e-
aaep   	0.90  1E-11   100  1000   SM .false. scatter a  a  -> e+ e-
#aepep 	0.90  1E-11   100  1000   SM  .true. scatter a  a  -> e+ e- e+ e-
eaea   	0.90  1E-11   100  1000   SM .false. scatter e- a  -> e- a
epaa   	0.90  1E-11   100  1000   SM  .true. scatter e+ e- -> a a
epep   	0.65  1E-11   100  1000   SM .false. scatter e+ e- -> e+ e-
