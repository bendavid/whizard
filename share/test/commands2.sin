model = SM

library = "commands2"

process commands2_eemm = e1, E1 => e2, E2 { $method = "test" }

compile ("commands2")

sqrts = 100 GeV

me = 0
mmu = 0

!!! Tests should be run single-threaded 
openmp_num_threads = 1

seed = 0
integrate (commands2_eemm) 
tolerance = 1e-4
expect (integral (commands2_eemm) ==~ 1.000)

show (results)