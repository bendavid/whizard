model = QED

process stdhep_eemm =	e1, E1	=>  e2, E2

compile

!---------------------------------------------

sqrts = 500 GeV
beams = e1, E1

!!! Tests should be run single-threaded 
openmp_num_threads = 1

integrate (stdhep_eemm) {
  iterations = 1:2000
}

$sample = "stdhep_eemm"
sample_format = stdhep
n_events = 10

simulate (stdhep_eemm)
