# NOTE: This file is outdated and obsolete

model = "TEST"

alias q = u:d
alias Q = U:D
alias jet = q:Q:g

library = "proc"

process plain_qq   =	g,  g	->  q, Q
process plain_nnh  =	e1, E1	->  nue, nuebar, H

compile ("proc") { fcflags = "-O3" }
!---------------------------------------------
load ("proc")

beams (p, p) { cm_energy = 14 TeV }
strfun (1, 2) = lhapdf

include ("set_ptcut.in")

loop (real mh = 100 GeV, 
                steps (120 GeV, 140 GeV, 3 GeV), 
                scale (150 GeV, 1 TeV, 2)) {
  real foo = mh
}

cuts = 
  all Pt > ptcut (outgoing jet)

integrate (plain_qq) {
  scale = 1 TeV
  iterations (4, 1000)
  iterations (3, 2000)
}

simulate (plain_qq) {
  luminosity = 0.1 ipb
  write ("plain_qq.dat")  { format = HepMC }
  write ("plain_qq.lhef") { format = LHEF }
}
