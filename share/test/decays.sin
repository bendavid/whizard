process decays_zee =	Z => e1, E1
process decays_zuu =	Z => u, U 

process decays_zz = e1, E1 => Z, Z
compile

!---------------------------------------------
me = 0

integrate (decays_zee) { iterations = 1:100 }
integrate (decays_zuu) { iterations = 1:100 }

sqrts = 500 GeV
beams = e1, E1
integrate (decays_zz) { iterations = 3:5000, 2:5000 }

unstable Z (decays_zee, decays_zuu)

n_events = 10
?write_raw = false
sample_format = ascii
$sample = "decays_zz"
simulate (decays_zz)
