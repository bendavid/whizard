process smtest_nnh =	e1, E1	=>  n1, N1, H

compile

!---------------------------------------------  

me = 0
mH = 115 GeV

sqrts = 500 GeV
beams = e1, E1

seed = 0
integrate (smtest_nnh) { iterations = 4:20000 }
printf "Expecting 84.883 fb"
tolerance = 3*0.14
expect (integral (smtest_nnh) ==~ 84.883      )

show (results)
