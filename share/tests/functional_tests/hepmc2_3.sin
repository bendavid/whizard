# SINDARIN input for WHIZARD self-test

?logging = true
?openmp_logging = false
?vis_history = false
?integration_timer = false
?write_raw = false

seed = 0

process hepmc2_3_p = u, U => g, g

sqrts = 1000
beams = p, p => pdf_builtin
iterations = 1:100
integrate (hepmc2_3_p)

n_events = 1
sample_format = hepmc2

$sample = "hepmc2_3.1"
?keep_beams = false
!!! Tests should be run single-threaded 
openmp_num_threads = 1
simulate (hepmc2_3_p)

$sample = "hepmc2_3.2"
?keep_beams = true
simulate (hepmc2_3_p)
