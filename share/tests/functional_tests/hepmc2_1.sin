# SINDARIN input for WHIZARD self-test for HepMC2 event format

?logging = true
?openmp_logging = false
?vis_history = false
?integration_timer = false
?write_raw = false

seed = 0

process hepmc2_1_p = e1, E1 => e2, E2

sqrts = 1000

iterations = 1:100
integrate (hepmc2_1_p)

n_events = 1
sample_format = hepmc2
!!! Tests should be run single-threaded 
openmp_num_threads = 1
simulate (hepmc2_1_p)
