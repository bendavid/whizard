#!/bin/sh
# Run GAMELAN on file $1, after preprocessing 

MP=mpost
MPFILE=`expr $1 : '\(.*\)\.mp$' \| $1`
if test -f ./gamelan.mem; then
  GMLDIR=.
elif test -f TESTFLAG; then
  GMLDIR=/Users/reuter/Physik/progs/whizard/trunk/build/src/gamelan
else 
  GMLDIR=/Users/reuter/local/lib/whizard/gamelan
fi

export TEX=latex
export MPINPUTS="$GMLDIR:$MPINPUTS"

/opt/local/bin/gsed \
-e's/<<!/ verbatimtex /g' \
-e's/<</ btex /g' \
-e's/>>/ etex /g' \
-e's/#\([+-]\{0,1\}[0-9][0-9]*\.[0-9]*[A-Za-z][+-]*[0-9][0-9]*\)/#"\1"/g' \
-e's/#\([+-]\{0,1\}[0-9][0-9]*[A-Za-z][+-]*[0-9][0-9]*\)/#"\1"/g' \
-e's/#\([+-]\{0,1\}\.[0-9][0-9]*[A-Za-z][+-]*[0-9][0-9]*\)/#"\1"/g' \
-e's/#\([+-]\{0,1\}[0-9][0-9]*\.[0-9]*\)/#"\1"/g' \
-e's/#\([+-]\{0,1\}\.[0-9][0-9]*\)/#"\1"/g' \
-e's/#\([+-]\{0,1\}[0-9][0-9]*\)/#"\1"/g' \
$MPFILE.mp > $MPFILE.$$.tmp && \
mv $MPFILE.$$.tmp $MPFILE.mp && $MP --jobname=$MPFILE "\\input $GMLDIR/gamelan" "\\input $MPFILE.mp"
exit 0
