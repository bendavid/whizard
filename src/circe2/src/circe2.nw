<<Skip data until [[ECRIC2]]>>=
 101  continue
      read (lun, *) buffer
      if (buffer(1:6) .ne. 'ECRIC2') then
         goto 101
      end if
@ 
<<Skip data until [[ECRIC2]] (C)>>=
while (1) {
  fgets (buffer, 72, f);
  if (strncmp ("ECRIC2", buffer, 6) == 0)
    break;
