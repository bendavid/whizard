<<Procedures>>=
      double precision function cir2dn (p1, h1, p2, h2, yy1, yy2)
      <<[[implicit none]]>>
      integer p1, h1, p2, h2
      double precision yy1, yy2
      <<[[/cir2cm/]]>>
      double precision y1, y2
      integer i, ic, i1, i2, ibot, itop
      <<Find [[ic]] for [[p1]], [[h1]], [[p2]] and [[h2]]>>
      if (ic .le. 0) then
         cir2dn = 0
         return
