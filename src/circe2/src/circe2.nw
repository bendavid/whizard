@ %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{Luminosity}
<<Procedures>>=
      double precision function cir2lm (p1, h1, p2, h2)
      <<[[implicit none]]>>
      integer p1, h1, p2, h2
      <<[[/cir2cm/]]>>
      integer ic
      cir2lm = 0
      do 10 ic = 1, nc
         if (       ((p1 .eq. pid1(ic)) .or. (p1 .eq. 0))
     $        .and. ((h1 .eq. pol1(ic)) .or. (h1 .eq. 0))
     $        .and. ((p2 .eq. pid2(ic)) .or. (p2 .eq. 0))
     $        .and. ((h2 .eq. pol2(ic)) .or. (h2 .eq. 0))) then
            cir2lm = cir2lm + lumi(ic)
         end if
 10   continue
      end
<<Separator2>>
@ 
<<Public Procedures (C)>>=
double
circe2_lumi (circe2_channels *channels, int p1, int h1, int p2, int h2)
{
  int i;
  double lumi;
  POINTER_PANIC(circe2_random_channel, channels, "channels");
  lumi = 0;
  for (i = 0; i < channels->n; i++) {
    circe2_channel *c = channels->ch[i];
    if (((p1 == c->d1->pid) || (p1 == 0))
	&& ((h1 == c->d1->pol) || (h1 == 0))
        && ((p2 == c->d2->pid) || (p2 == 0))
	&& ((h2 == c->d2->pol) || (h2 == 0)))
      lumi += c->lumi;
  }
  return lumi;
}
