<<Open [[name]] for reading on [[lun]]>>=
      open (unit = lun, file = file, status = 'old', iostat = status)
      if (status .ne. 0) then
         write (*, '(2A)') 'cir2ld: can''t open ', file
         ierror = EFILE
         return
      end if
