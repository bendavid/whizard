         ierror = EFORMT
         return
      else if (polspt .eq. POLGEN
     $     .and. (      (pol1(ic) .ne. 0)
     $             .or. (pol2(ic) .ne. 0))) then
         write (*, '(A)') 'cir2ld: expecting pol = 0'
         ierror = EFORMT
