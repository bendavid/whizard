@ 
<<$[[x2]]\in[ [[ch->d2->x[i2-1] ]], [[ch->d2->x[i2] ]] ]$ (C)>>=
      rng (&u);
      x2 = ch->d2->x[i2]*u + ch->d2->x[i2-1]*(1-u);
