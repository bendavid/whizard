@ %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{Channel selection}
We could call [[cir2gn]] immediately, but then [[cir2gn]] and
[[cir2ch]] would have the same calling conventions and might have
caused a lot of confusion.
<<Procedures>>=
      subroutine cir2ch (p1, h1, p2, h2, rng)
      <<[[implicit none]]>>
      integer p1, h1, p2, h2
      external rng
      <<[[/cir2cm/]]>>
      integer ic, ibot, itop
      double precision u
      call rng (u)
      ibot = 0
      itop = nc
  10  continue
      if (itop .le. (ibot + 1)) then
         ic = ibot + 1
         p1 = pid1(ic)
         h1 = pol1(ic)
         p2 = pid2(ic)
         h2 = pol2(ic)
         return
      else
         ic = (ibot + itop) / 2
         if (u .lt. cwgt(ic)) then
            itop = ic
         else
            ibot = ic
         end if
         goto 10
      end if
      write (*, '(A)') 'circe2: internal error'
      stop
      end
