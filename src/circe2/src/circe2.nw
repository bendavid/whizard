<<Private Procedures (C)>>=
static int
binary_search (double *x, int bot, int top, double u)
{
  int low = bot;
  int high = top;
  while (1) {
    if (high <= (low + 1)) {
      return (low + 1);
      break;
    } else {
      int i = (low + high) / 2;
      if (u < x[i])
	high = i;
      else
	low = i;
    }
  }
}
