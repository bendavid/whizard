<<$[[x1]]\in[ [[xb1(i1-1)]], [[xb1(i1)]] ]$>>=
      call rng (u)
      x1 = xb1(i1,ic)*u + xb1(i1-1,ic)*(1-u)
@ 
<<$[[x2]]\in[ [[xb2(i2-1)]], [[xb2(i2)]] ]$>>=
      call rng (u)
      x2 = xb2(i2,ic)*u + xb2(i2-1,ic)*(1-u)
