<<Check if [[design]] and [[fdesgn]] do [[match]]>>=
      match = .false.
      if (fdesgn .eq. design) then
         match = .true.
      else if (prefix .eq. 0) then
         match = .true.
      else if (prefix .gt. 0) then
         if (fdesgn(1:min(prefix,len(fdesgn)))
     $        .eq. design(1:min(prefix,len(design)))) then
            match = .true.
         end if
      end if
