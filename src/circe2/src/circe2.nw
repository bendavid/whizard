<<Check polarization support>>=
      if (polspt .eq. POLAVG
     $     .and. (      (pol1(ic) .ne. 0)
     $             .or. (pol2(ic) .ne. 0))) then
         write (*, '(A)')
     $        'cir2ld: expecting averaged polarization'
         ierror = EFORMT
         return
      else if (polspt .eq. POLHEL
     $     .and. (      (pol1(ic) .eq. 0)
