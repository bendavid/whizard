  subroutine integration_check_beam_data (intg, beam_data)
    type(integration_t), intent(inout) :: intg
    type(beam_data_t), intent(in) :: beam_data
    intg%beam_data = beam_data
    intg%use_beams = beam_data_are_valid (intg%beam_data)
