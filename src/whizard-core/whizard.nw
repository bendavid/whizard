<<SF pdf builtin: tests>>=
  subroutine sf_pdf_builtin_3 (u)
    integer, intent(in) :: u
    type(os_data_t) :: os_data
    type(model_list_t) :: model_list
    type(pdf_builtin_status_t) :: status
    type(qcd_t) :: qcd
    type(string_t) :: name
    
