  public :: color_is_diagonal
<<Colors: procedures>>=
  elemental function color_is_diagonal (col) result (diagonal)
    logical :: diagonal
    type(color_t), intent(in) :: col
    if (color_is_defined (col)) then
       diagonal = all (col%c1 == col%c2)
    else
       diagonal = .true.
    end if
