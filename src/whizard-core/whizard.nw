<<File header>>

module user_code_interface

  use iso_c_binding !NODEP!
<<Use kinds>>
<<Use strings>>
  use diagnostics !NODEP!
  use c_particles !NODEP!
  use os_interface

<<Standard module head>>

<<User Code: public>>

<<User Code: variables>>

<<User Code: interfaces>>

