  use phs_base
  use rng_base
  use mci_base
  
<<Standard module head>>

<<MCI midpoint: public>>

<<MCI midpoint: types>>

<<MCI midpoint: test types>>

contains
  
<<MCI midpoint: procedures>>

<<MCI midpoint: tests>>

end module mci_midpoint
