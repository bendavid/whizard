  use lorentz !NODEP!
  use unit_tests
  use permutations
  use ifiles
  use syntax_rules
  use lexers
  use parser
  use models
  use flavors
  use interactions

  use phs_base
  use mappings
  use phs_trees

<<Standard module head>>

<<PHS forests: public>>

<<PHS forests: types>>

<<PHS forests: interfaces>>

<<PHS forests: variables>>

contains

<<PHS forests: procedures>>

<<PHS forests: tests>>

end module phs_forests
