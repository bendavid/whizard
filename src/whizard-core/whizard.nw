<<Template matrix elements: tests>>=
  subroutine prc_template_me_recover_kinematics &
       (object, p_seed, int_hard, int_eff, tmp)
    class(prc_template_me_t), intent(in) :: object
    type(vector4_t), dimension(:), intent(inout) :: p_seed
