    shower_settings%ps_isr_primordial_kt_cutoff = &
         var_list_get_rval (var_list, var_str ("ps_isr_primordial_kt_cutoff"))
    shower_settings%ps_isr_z_cutoff = &
         var_list_get_rval (var_list, var_str ("ps_isr_z_cutoff"))
