    select case (par%type)
    case (PAR_INDEPENDENT)
       buffer = par%name
       write (u, "(4x,A,1x,'=',1x," // FMT_19 // ")")  buffer, par%value
    end select
  end subroutine parameter_show_independent
    
  subroutine parameter_show_derived (par, l, u)
