<<Iterations: iterations list: TBP>>=
  procedure :: get_n_it => iterations_list_get_n_it
<<Iterations: procedures>>=
  function iterations_list_get_n_it (it_list, pass) result (n_it)
    class(iterations_list_t), intent(in) :: it_list
