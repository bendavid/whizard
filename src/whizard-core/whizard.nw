@ %def subevt_get_length
@ Return a specific particle.  The index is not checked for validity.
<<Subevents: public>>=
  public :: subevt_get_prt
<<Subevents: procedures>>=
  function subevt_get_prt (subevt, i) result (prt)
    type(prt_t) :: prt
