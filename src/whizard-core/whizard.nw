    n = observable_get_n_entries (obs)
    write (u, "(A,1x," // HISTOGRAM_DATA_FORMAT // ")") &
         "average     =", avg
    write (u, "(A,1x," // HISTOGRAM_DATA_FORMAT // ")") &
         "error[abs]  =", err
    write (u, "(A,1x," // HISTOGRAM_DATA_FORMAT // ")") &
         "error[rel]  =", relerr
    write (u, "(A,1x," // HISTOGRAM_INTG_FORMAT // ")") &
         "n_entries   =", n
