    md5sum = model_get_parameters_md5sum (model_instance)
    write (u, *)
    write (u, "(1x,3A)")  "MD5 sum (parameters) = '", md5sum, "'"

    write (u, *)
    write (u, "(A)")  "* Cleanup"
    
    call model_final (model_instance)
    deallocate (model_instance)
    call model_list%final ()
    call syntax_model_file_final ()

