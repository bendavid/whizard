\subsection{The event type}
<<Events: public>>=
  public :: event_t
<<Events: types>>=
  type :: event_t
     private
     integer :: num_proc_id = 0
     type(process_t), pointer :: process => null ()
     type(event_vars_t), pointer :: vars => null ()
