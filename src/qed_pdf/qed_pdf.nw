        zeta3)))/(3._wp*x) + (2._wp*(2._wp*(7._wp*ln2**3 + pi2*(-3._wp*ln2 - pl(1)) - &
        pl(1)**3 + 6._wp*(-(pl(1)*pl(6)) - pl(1)*pl(8) - 4._wp*(pl(7) + pl(9)))) + &
        39._wp*zeta3))/3._wp
      ints(5) = (-4._wp*pi2)/3._wp + (4._wp*(pi2 - 6._wp*pl(4)))/(3._wp*x)
      ints(6) = 0._wp
      ints(7) = 4._wp - 4._wp/x
