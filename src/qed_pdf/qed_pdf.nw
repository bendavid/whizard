      ints(5) = -1._wp/3._wp*(pi2*xb)
    elseif (x .le. 1.0e-7_wp) then
      ints(1) = -4._wp/3._wp
      ints(2) = 1._wp
      ints(3) = 2._wp*(n*pi2 - 2._wp*(1._wp - pi)*(1._wp + pi))
      ints(4) = (4._wp*ln2*(2._wp*pi2 + 5._wp*(3._wp - 2._wp*ln2)*ln2) + &
        3._wp*(-2._wp*(8._wp + pi2) + (61._wp + 24._wp*n)*zeta3))/6._wp
    else
