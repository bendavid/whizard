\chapter{Poor Man's Elemental Procedures}
On one hand, I want to take advantage of Fortran95's improvements, but
on the other hand, I want to continue to use [[F]] as a style guide
and also allow people with Fortran90 compilers to use the library.
@ %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{\texttt{m4} Macros}
<<[[f95.m4]]>>=
dnl f95.m4 --
divert(-1)dnl
<<Kill m4(1) builtins>>
define(`_specific_sv',`dnl')
define(`_interface_sv',`dnl')
define(`_specific_sva',`dnl')
define(`_interface_sva',`dnl')
define(`_begin_f90',`divert(-1)dnl')
define(`_end_f90',`divert`'dnl')
divert`'dnl
@ %def _specific_sv _interface_sv _specific_sva _interface_sva
@ %def _begin_f90 _end_f90
@ 
<<Kill m4(1) builtins>>=
undefine(`eval')
@
<<[[f90.m4]]>>=
dnl f90.m4 --
divert(-1)dnl
<<Kill m4(1) builtins>>
define(`pure',`')
define(`elemental',`')
define(`_specific_sv',`private :: $1_s, $1_v')
define(`_interface_sv',`interface $1
     module procedure $1_s, $1_v
  end interface`'define($1,$1_s)')
define(`_specific_sva',`private :: $1_s, $1_v, $1_a')
define(`_interface_sva',`interface $1
     module procedure $1_s, $1_v, $1_a
  end interface`'define($1,$1_s)')
define(`_begin_f90',`dnl')
define(`_end_f90',`dnl')
divert`'dnl
@ %def _specific_sv _interface_sv _specific_sva _interface_sva
@ %def _begin_f90 _end_f90

