  print_endline (string_of_int Sys.word_size)
  EOF
  OCAML_WORD_SIZE=`ocaml conftest.ml`
  AC_MSG_RESULT([$OCAML_WORD_SIZE])
  AC_SUBST([OCAML_WORD_SIZE])
])
