  AC_MSG_RESULT([(disabled)])
fi

AC_SUBST([PYTHIA8_CXXFLAGS])
AC_SUBST([PYTHIA8_LIBS])

if test "$enable_pythia8" = "yes"; then
   PYTHIA8_AVAILABLE_FLAG=".true."
else
