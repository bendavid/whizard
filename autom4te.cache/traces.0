        changequote([,])])
  EPSPDFINTEGERVERSION=$wo_epspdf_cv_integer_version
  AC_SUBST([EPSPDFVERSION])
  if test $EPSPDFINTEGERVERSION -ge 004003; then
    AC_MSG_RESULT([epspdf present and newer than 0.4.2; using epspdf for conversion.])
  else
