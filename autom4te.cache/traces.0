if test "${lhapdfok}" = "yes"; then
   LHAPDF_CXXFLAGS="`${LHAPDF_CONFIG} --cxxflags`"
   LDFLAGS_LHAPDF="`${LHAPDF_CONFIG} --ldflags`"
   LHAPDF_LIBS="$LDFLAGS_LHAPDF"
   AC_SUBST(LHAPDF_LIBS)
   AC_MSG_RESULT(yes)
   $1          
else
   AC_MSG_RESULT(no)
   enable_lhapdf=no
   $2
fi

AC_SUBST([LHAPDF_CXXFLAGS])
AC_SUBST([LDFLAGS_LHAPDF])

