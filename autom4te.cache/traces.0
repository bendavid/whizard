echo "StdHEP (event format)                      :   yes, v5.06.01"
echo "--------------------------------------------------------------"
echo "---      External packages      ---"
echo "--------------------------------------------------------------"
if test "$HEPMC2_AVAILABLE_FLAG" = ".true." ; then
   echo "HepMC2 (event format):   yes, v$HEPMC2_VERSION"
else
