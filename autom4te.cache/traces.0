  fi
  AM_CONDITIONAL([EPSPDF_043],
	[test $EPSPDFINTEGERVERSION -ge 004003])
else  
  AM_CONDITIONAL([EPSPDF_043],false)  
  EPSPDFINTEGERVERSION=000000
fi
  AC_SUBST([EPSPDFINTEGERVERSION])

])
