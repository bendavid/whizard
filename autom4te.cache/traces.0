     AC_MSG_RESULT([$FASTJET_VERSION])
     AC_SUBST([FASTJET_VERSION])
  fi
else
  AC_MSG_CHECKING([for FASTJET])
  AC_MSG_RESULT([(disabled)])
fi

FASTJET_AVAILABLE_FLAG=$enable_fastjet

AC_SUBST([FASTJET_CXXFLAGS])
AC_SUBST([FASTJET_LIBS])
